# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://ytuwpdsmdjwqmflthagg.supabase.co
# Publishable / anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_vPpYXFnsnHGcdc3tlY7AlQ_siABimfq
# Secret / service_role key: SERVER ONLY, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Who may use the app ----------
# Comma list of emails and/or @domains. Empty = any signed-up user.
ALLOWED_EMAILS=you@company.com,@yourteam.com
# Who can add/edit/delete sub-accounts. Empty = every allowed user.
ADMIN_EMAILS=you@company.com

# ---------- Voximplant (shared by all sub-accounts) ----------
VOX_USER=webuserr2
VOX_APP=ghl-dialer.arslanamjad1073
VOX_NODE=NODE_2
VOX_PASSWORD=
VOX_CALL_NUMBER=crm

# ---------- Leads page (AI summaries) ----------
# Same Gemini key as the Voximplant scenario's GEMINI_API_KEY secret
GEMINI_API_KEY=
# Optional: model for summaries (default gemini-3.8-flash)
# GEMINI_TEXT_MODEL=gemini-3.8-flash

# ---------- Push notifications (new contact messages) ----------
# Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@company.com

# ---------- Scenario <-> app ----------
# Long random string; put the same value in Voximplant Secrets as SCENARIO_SECRET.
# Generate one with:  openssl rand -hex 32
SCENARIO_SECRET=
