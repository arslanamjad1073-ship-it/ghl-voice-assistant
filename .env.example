# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://ytuwpdsmdjwqmflthagg.supabase.co
# Publishable / anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_vPpYXFnsnHGcdc3tlY7AlQ_siABimfq
# Secret / service_role key: SERVER ONLY, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Who may start a new organization ----------
# Comma list of emails and/or @domains. Empty = anyone who signs up can start their own organization.
# Team members join by invite and never need to be listed here. Roles and permissions are set in the app (Team page).
ALLOWED_EMAILS=
# Optional: public URL used in invite links (default: the URL the app is opened on)
# APP_URL=https://ghl-voice-assistant.vercel.app

# ---------- Voximplant (shared by all sub-accounts) ----------
VOX_USER=webuserr2
VOX_APP=ghl-dialer.arslanamjad1073
VOX_NODE=NODE_2
VOX_PASSWORD=
VOX_CALL_NUMBER=crm

# ---------- AI (optional) ----------
# Keys are normally added in the app under AI settings & usage. This Gemini key is only a fallback.
GEMINI_API_KEY=
# Optional: model for summaries (default gemini-3.8-flash)
# GEMINI_TEXT_MODEL=gemini-3.8-flash

# ---------- Push notifications (new contact messages) ----------
# Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@company.com

# ---------- Scenario <-> app ----------
# Long random string; put the same value in Voximplant Secrets as SCENARIO_SECRET.
# Generate one with:  openssl rand -hex 32
SCENARIO_SECRET=

# ---------- Nova GHL Marketplace app (one-click message alerts) ----------
# From the GHL developer portal (Advanced settings › Auth). The secret is server only.
GHL_APP_CLIENT_ID=
GHL_APP_CLIENT_SECRET=
# The app's install link from the portal (…/oauth/chooselocation?response_type=code&redirect_uri=…&client_id=…&scope=…&version_id=…)
GHL_APP_INSTALL_URL=
# Optional: GHL's webhook public key (PEM). Adds a signature check; messages are always confirmed with GHL anyway.
# GHL_APP_WEBHOOK_PUBLIC_KEY=
